<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Adds a repo-local package source containing the UglyToad.PdfPig 1.7.0-custom-5
    packages (used by Bank-Statement Reconciliation to read PDF statements). This
    lets the Docker/VM build restore PdfPig without access to the internal feed it
    was originally pulled from. Existing sources (nuget.org / machine feeds) are
    kept for all other packages.
  -->
  <packageSources>
    <add key="smms-local" value="local-nuget" />
  </packageSources>
</configuration>

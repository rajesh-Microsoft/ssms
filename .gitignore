# Python
.venv/
.venv-*/
__pycache__/
*.pyc

# Data files (contain real financial/personal data - keep out of git)
*.xlsx
*.csv
data/*.pdf
!data/.gitkeep

# Database backups. These restore to full societies: resident PII, payment
# history, UPI IDs and password hashes. Never commit them.
*.bak
*.tar.gz
*.zip
data/sql-backups/
backups/

# Walkthrough recordings film a live society. Even blurred, keep them out of git.
tools/walkthrough/
node_modules/
package-lock.json

# .NET
api/**/bin/
api/**/obj/
*.user

# IDE cache (Visual Studio)
api/**/.vs/

# Local-dev compose overrides. Must never reach the VM: it would move the UI
# off 443 and swap in the HTTP-only nginx config.
docker-compose.override.yml

# Secrets consumed by docker compose (Razorpay keys, etc.)
.env
.env.*
!.env.example

# Ops script output. Routinely contains secrets read back off the VM.
*.log

# Pre-prod staging handoff. stage-url.txt holds a live read/write SAS URL for the
# code archive, so it must never be committed.
deploy/pprod/stage-url.txt
deploy/pprod/stage-account.txt

# Working copies pulled off the VM for comparison. The uat-snapshot-* branch is
# the durable record; these are scratch.
uat-capture/

# OS
Thumbs.db
.DS_Store

# Developer portal audit log (local record of who deployed what)
devportal/audit.log

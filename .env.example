# Copy to .env and fill in real values. .env is git-ignored — never commit it.
# Docker Compose reads this file automatically and injects the values into smms-api.

RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Must match the secret configured on the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=
# Comma separated society keys, or "*" for all. Empty means no society can pay
# by card: a test key reaching a real society would clear real dues for free.
RAZORPAY_ALLOWED_SOCIETIES=

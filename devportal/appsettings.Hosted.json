{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",

  "_note": "Configuration for the copy hosted on the dev VM. Probes are local because the API runs on the same box as the dev and UAT stacks, so no SSH key is copied anywhere. Pre-prod is unreachable from here (it needs az vm run-command) and says so instead of guessing.",

  "Portal": {
    "AllowWrites": false,
    "RequireAuthForReads": true,
    "CacheSeconds": 30,
    "AuditLogPath": "/app/audit.log",
    "RepositoryName": "rrathore_microsoft/SMMS",
    "RepositoryUrl": "https://github.com/rrathore_microsoft/SMMS",
    "AllowedOrigins": [ "https://dev-portal.yuvaansoft.shop" ],

    "Applications": [
      { "Key": "smms", "Name": "SMMS", "Icon": "bi-buildings", "Description": "Society Maintenance Management", "Active": true },
      { "Key": "cms", "Name": "Clinic Management", "Icon": "bi-heart-pulse", "Description": "Clinic Management System", "Active": false },
      { "Key": "schoolerp", "Name": "School ERP", "Icon": "bi-mortarboard", "Description": "School ERP", "Active": false },
      { "Key": "hrms", "Name": "HRMS", "Icon": "bi-people", "Description": "Human Resources", "Active": false },
      { "Key": "inventory", "Name": "Inventory", "Icon": "bi-box-seam", "Description": "Inventory Management", "Active": false },
      { "Key": "crm", "Name": "CRM", "Icon": "bi-graph-up-arrow", "Description": "Customer Relationships", "Active": false }
    ],

    "Environments": [
      {
        "Id": "smms-dev",
        "App": "smms",
        "Tier": "DEV",
        "Name": "Development",
        "Hostname": "dev-demo.yuvaansoft.shop",
        "AppUrl": "https://dev-demo.yuvaansoft.shop/",
        "ApiUrl": "https://dev-demo.yuvaansoft.shop/api/health",
        "DataSensitivity": "Cloned production data",
        "DeploymentEnabled": true,
        "Image": "smms-dev-smms-api",
        "Pipeline": "deploy/promote.ps1 -Environment dev",
        "Database": "SmmsDb_<tenant>",
        "Server": "ssms-webserver (135.235.195.132)",
        "Probe": { "Type": "local", "Root": "/stacks/dev", "ComposeProject": "smms-dev" }
      },
      {
        "Id": "smms-pprod",
        "App": "smms",
        "Tier": "PREPROD",
        "Name": "Pre-Production",
        "Hostname": "pprod-aadya.ssms.yuvaansoft.shop",
        "AppUrl": "https://pprod-aadya.ssms.yuvaansoft.shop/",
        "ApiUrl": "https://pprod-aadya.ssms.yuvaansoft.shop/api/health",
        "DataSensitivity": "Full clone of production, real PII",
        "DeploymentEnabled": true,
        "Image": "smms-pprod-smms-api",
        "Pipeline": "deploy/promote.ps1 -Environment pprod",
        "Database": "SmmsDb_<tenant>",
        "Server": "smms-pprod-vm (20.219.1.173)",
        "Note": "On another VM reachable only through az vm run-command, so this portal reports its health but cannot read its commit.",
        "Probe": { "Type": "none" }
      },
      {
        "Id": "smms-uat",
        "App": "smms",
        "Tier": "UAT",
        "Name": "UAT",
        "Hostname": "demo.yuvaansoft.shop",
        "AppUrl": "https://demo.yuvaansoft.shop/",
        "ApiUrl": "https://demo.yuvaansoft.shop/api/health",
        "DataSensitivity": "REAL resident data and real money records",
        "DeploymentEnabled": true,
        "Image": "smms-smms-api",
        "Pipeline": "deploy/promote.ps1 -Environment uat",
        "Database": "SmmsDb_<tenant>",
        "Server": "ssms-webserver (135.235.195.132)",
        "Probe": { "Type": "local", "Root": "/stacks/uat", "ComposeProject": "smms" }
      },
      {
        "Id": "smms-lookalike",
        "App": "smms",
        "Tier": "UAT",
        "Name": "Look-alike host (blocked)",
        "Hostname": "dev-aadya.ssms.yuvaansoft.shop",
        "AppUrl": "https://dev-aadya.ssms.yuvaansoft.shop/",
        "DataSensitivity": "Reached the stack holding real data until this was blocked",
        "DeploymentEnabled": false,
        "Hazard": true,
        "Note": "Reads like development and is not. nginx returns 404; a 200 here means the guard has been lost.",
        "Probe": { "Type": "none" }
      },
      {
        "Id": "smms-prod",
        "App": "smms",
        "Tier": "PROD",
        "Name": "Production",
        "Hostname": "(not provisioned)",
        "DataSensitivity": "REAL customer data",
        "DeploymentEnabled": false,
        "Note": "Production must not run on the current subscription.",
        "Probe": { "Type": "none" }
      }
    ]
  }
}

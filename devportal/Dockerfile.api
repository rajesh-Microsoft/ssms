# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY api/DevPortal.Api/ ./DevPortal.Api/
RUN dotnet restore ./DevPortal.Api/DevPortal.Api.csproj
RUN dotnet publish ./DevPortal.Api/DevPortal.Api.csproj -c Release -o /app/publish

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/publish .

# The probe shells out to bash; git is here so commit metadata works if a clone is mounted.
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

EXPOSE 8080
ENTRYPOINT ["dotnet","DevPortal.Api.dll"]
